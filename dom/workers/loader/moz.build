with Files("**"):
    BUG_COMPONENT = ("Core", "DOM: Workers")

# Public stuff.
EXPORTS.mozilla.dom += [
    "ScriptLoadInfo.h",
]

# Private stuff.
EXPORTS.mozilla.dom.workerinternals += [
    "CacheLoadHandler.h",
    "NetworkLoadHandler.h",
]

UNIFIED_SOURCES += [
    "CacheLoadHandler.cpp",
    "NetworkLoadHandler.cpp",
]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"
